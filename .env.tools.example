# Local batch/AI tooling settings.
# Copy to .env.tools.local at the repository root.
#
# Scripts load this file first, then .env.local for shared app settings such as
# DATABASE_URL and QUESTIONS_OUT_DIR.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_META_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=65536
OPENAI_HTML_MAX_OUTPUT_TOKENS=10000
OPENAI_IMAGE_DETAIL=high
HTML_MAX_OUTPUT_TOKENS=10000

# Gemini key rotation
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_META_MODEL=gemini-3.5-flash
GEMINI_HTML_MODEL=gemini-3.5-flash
GEMINI_DEFAULT_MAX_OUTPUT_TOKENS=65536

# CLI providers (optional)
# CODEX_CLI_BIN=
# CODEX_CLI_MODEL=
# CODEX_CLI_HTML_MODEL=
# ANTIGRAVITY_CLI_BIN=
# ANTIGRAVITY_CLI_MODEL=
# ANTIGRAVITY_CLI_HTML_MODEL=
# CLAUDE_CLI_BIN=
# CLAUDE_CLI_MODEL=claude-sonnet-4-6
# CLAUDE_CLI_HTML_MODEL=claude-sonnet-4-6
# CURSOR_CLI_BIN=
# CURSOR_CLI_MODEL=composer-2.5
# CURSOR_CLI_HTML_MODEL=composer-2.5
PASSBAR_CLI_AI_TIMEOUT=900

# Cursor API provider (optional)
CURSOR_API_KEY=
CURSOR_API_MODEL=composer-2.5
CURSOR_API_HTML_MODEL=gpt-5.4-mini
CURSOR_API_HTML_FALLBACK_MODEL=gpt-5.4-mini

# Output overrides (optional)
# OUT_DIR=
