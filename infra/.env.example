# Shared env file for infra/docker-compose.yml (frontend + backend containers).
# Copy to infra/.env and fill in real values. Never commit infra/.env.
#
# This is the PRODUCTION counterpart of the root .env.example (local dev). Keep
# variable names in sync between the two files — when you add/rename one here,
# add/rename the same one there, even though the values differ (prod vs local).

# ── backend ──────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=https://passbar.wayneclub.com

# Shared postgres container on the host's database-network (see docker-compose.yml comments)
DATABASE_URL=postgresql://postgres:your_strong_password_here@postgres:5432/passbar?sslmode=require

# Must match auth-service's JWT_SECRET exactly — backend only verifies tokens, never issues them
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Shared secret for server-to-server cron requests (POST /internal/cron/notifications)
CRON_SECRET=

# Where the backend reaches auth-service server-side (not the NEXT_PUBLIC_ browser-facing one).
# Both containers share `npm_network`, so the internal hostname avoids an extra hop through
# nginx-proxy-manager — only fall back to the public https://auth.wayneclub.com if that's not the case.
AUTH_SERVICE_URL=http://auth-service:4010

# Must match auth-service's SERVICE_SECRET exactly — used to call its
# PATCH /internal/memberships/status endpoint when an admin approves/rejects a user
SERVICE_SECRET=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@passbar.app

# ── frontend (runtime only) ──────────────────────────────────────────────
# NEXT_PUBLIC_* vars are baked into the image at build time by GitHub Actions
# (see repo Settings → Secrets and variables → Actions), NOT read here at
# runtime — setting them in this file has no effect on the frontend container.
GOOGLE_GENAI_API_KEY=
GEMINI_API_KEY=
# gemini-3.5-flash 對部分 key 會 404/503；backend 會自動 fallback 到
# gemini-2.5-flash / 2.5-pro / 2.0-flash（見 gemini-feedback.service.ts）。
GEMINI_MODEL=gemini-3.5-flash
