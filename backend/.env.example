PORT=4000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://user:password@localhost:5432/passbar?sslmode=require

# PassBar no longer handles Google OAuth itself — login happens on auth-service
# (auth.wayneclub.com). This value MUST be identical to auth-service's JWT_SECRET,
# or PassBar will reject every token auth-service issues.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Shared secret for server-to-server cron requests (POST /internal/cron/notifications).
# Leave empty in local dev to allow unauthenticated calls.
CRON_SECRET=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@passbar.app
