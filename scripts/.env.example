# Gemini API Keys for generate_zh_explanations.py
# Copy this file to .env and fill in your keys.
# Add as many keys as you have (GEMINI_API_KEY_1 ~ GEMINI_API_KEY_N).
# Keys are rotated round-robin; on 429 the next key is tried immediately.

GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=your_gemini_api_key_here
GEMINI_API_KEY_3=your_gemini_api_key_here

# Supabase — needed by generate_question_meta.py
# The script also reads passbar/.env.local automatically, so these are only
# required if you run the script from a different directory.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
