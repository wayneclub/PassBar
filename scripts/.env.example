# AI API keys for generate_zh_explanations.py
# Copy this file to .env and fill in your keys.

# OpenAI GPT provider:
# Run with: python3 generate_zh_explanations.py --provider gpt
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_META_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=65536
OPENAI_IMAGE_DETAIL=high

# Gemini provider:
# Add as many keys as you have (GEMINI_API_KEY_1 ~ GEMINI_API_KEY_N).
# Keys are rotated round-robin; on 429 the next key is tried immediately.

GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=your_gemini_api_key_here
GEMINI_API_KEY_3=your_gemini_api_key_here

# Codex CLI provider:
# Requires `codex` to be installed and logged in.
# Run with: python3 generate_question_outputs.py --provider codex-cli ...
# CODEX_CLI_BIN=/path/to/codex
# Default (light) model — used for translation, meta, and any mode without an HTML model override.
# CODEX_CLI_MODEL=
# Heavy model — used only for en-html / zh-html generation (needs high output-token limit).
# If unset, falls back to CODEX_CLI_MODEL.
# CODEX_CLI_HTML_MODEL=
# PASSBAR_CLI_AI_TIMEOUT=900

# Antigravity CLI provider:
# Requires `agy` to be installed and logged in.
# The adapter uses `agy --print` by default. Override only if your installed
# version needs a different non-interactive command. Supported placeholders:
# {prompt_file}, {output_file}, {model}, and {agy}.
# ANTIGRAVITY_CLI_BIN=/path/to/agy
# Default (light) model — used for translation, meta, and any mode without an HTML model override.
# ANTIGRAVITY_CLI_MODEL=
# Heavy model — used only for en-html / zh-html generation (needs high output-token limit).
# If unset, falls back to ANTIGRAVITY_CLI_MODEL.
# ANTIGRAVITY_CLI_HTML_MODEL=claude-sonnet-4-6
# ANTIGRAVITY_PRINT_TIMEOUT=15m
# For custom behavior, point ANTIGRAVITY_CLI_COMMAND at a wrapper script.
# ANTIGRAVITY_CLI_COMMAND='/path/to/agy-wrapper {prompt_file} {output_file} {model}'

# Supabase — needed by generate_question_meta.py
# The script also reads passbar/.env.local automatically, so these are only
# required if you run the script from a different directory.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
