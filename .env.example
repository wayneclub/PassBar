# Local PassBar application settings.
# Copy to .env.local at the repository root.
#
# This file is shared by the local frontend and backend. Keep batch/AI tooling
# credentials in .env.tools.local instead.
#
# This is the LOCAL DEV counterpart of infra/.env.example (production
# containers). Keep variable names in sync between the two files — when you
# add/rename one here, add/rename the same one there, even though the values
# differ (local vs prod).

# ── Frontend (browser-visible; never put secrets in NEXT_PUBLIC_*) ──────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:4010
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Frontend server routes ─────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CRON_SECRET=

# ── Backend ────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/passbar

# Must match auth-service.
JWT_SECRET=
JWT_EXPIRES_IN=7d
AUTH_SERVICE_URL=http://localhost:4010
SERVICE_SECRET=

# ── Web Push ───────────────────────────────────────────────────────────────
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@passbar.app

# Optional question import override. Defaults to ./out at the repository root.
QUESTIONS_OUT_DIR=
